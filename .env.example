# ──────────────────────────────────────────────
#  Health Insurance Pre-Authorization Desk
#  Environment Configuration Template
#  Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database (PostgreSQL) ────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=preauth_db
POSTGRES_USER=preauth_user
POSTGRES_PASSWORD=change-me-postgres

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# ── LLM Provider ─────────────────────────────
# Options: openai | ollama | stub
LLM_PROVIDER=stub
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local, zero-cost)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b-instruct

# Stub (for testing / load testing)
STUB_RESPONSE_DELAY_MS=500

# ── Embeddings ───────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── Vector Store ─────────────────────────────
VECTOR_STORE_PATH=/app/corpus/processed/faiss_index
VECTOR_STORE_TYPE=faiss
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=6

# ── Agent Configuration ──────────────────────
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_WALL_CLOCK_TIMEOUT_S=120
AGENT_RETRY_MAX=3
AGENT_RETRY_BACKOFF_BASE=2.0

# ── Circuit Breaker ──────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_S=60
CB_HALF_OPEN_CALLS=2

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500

# ── Observability ────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=preauth-backend
PROMETHEUS_PORT=9090

# ── Prompt Versioning ─────────────────────────
ACTIVE_PROMPT_VERSION=v1

# ── Caching ──────────────────────────────────
CACHE_EMBEDDING_TTL_S=86400
CACHE_RETRIEVAL_TTL_S=3600
CACHE_FULL_RUN_TTL_S=300

# ── Guardrails ───────────────────────────────
ENABLE_INJECTION_DEFENSE=true
ENABLE_TOXICITY_FILTER=true
TOXICITY_THRESHOLD=0.7

# ── Worker ───────────────────────────────────
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=100
